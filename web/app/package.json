{
  "name": "tgd-web",
  "private": true,
  "version": "0.0.0",
  "description": "The tgloggerd web UI: React pages rendered on the server by the render service and hydrated in the browser",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "gen:api": "openapi-typescript ../../webapi/openapi.yaml -o src/api/generated/schema.d.ts",
    "check:api": "node scripts/check-api.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "lottie-web": "5.12.2",
    "lucide-react": "1.74.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "happy-dom": "21.0.4",
    "js-yaml": "4.3.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
