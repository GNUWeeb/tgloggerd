{
  "name": "tgd-web",
  "private": true,
  "version": "0.0.0",
  "description": "The tgloggerd web UI: React pages rendered on the server by the render service and hydrated in the browser",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "gen:api": "openapi-typescript ../../webapi/openapi.yaml -o src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@tanstack/react-query": "5.108.0",
    "lucide-react": "1.74.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
