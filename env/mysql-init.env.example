# The daemon's database and user, created by the mysql image on its
# first start (and only then). The image's own setup does not quote
# these: keep backslashes out of MYSQL_PASSWORD (and of
# MYSQL_ROOT_PASSWORD in mysql-root.env). The web passwords may hold
# any character (docker/mysql/init quotes them).

MYSQL_DATABASE=tgloggerd
MYSQL_USER=tgloggerd
MYSQL_PASSWORD=change_me_tgloggerd
